#!/bin/sh
# Minimal Maven Wrapper bootstrapper. Downloads Maven only when it is not already installed.
set -eu
MAVEN_VERSION=3.9.11
MAVEN_DIR="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_DIR/bin/mvn"
if [ -x "$MAVEN_BIN" ]; then exec "$MAVEN_BIN" "$@"; fi
mkdir -p "$MAVEN_DIR"
ARCHIVE="$MAVEN_DIR/apache-maven-$MAVEN_VERSION-bin.tar.gz"
if [ ! -f "$ARCHIVE" ]; then
  if command -v curl >/dev/null 2>&1; then curl -fsSL "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" -o "$ARCHIVE";
  else wget -q "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" -O "$ARCHIVE"; fi
fi
tar -xzf "$ARCHIVE" --strip-components=1 -C "$MAVEN_DIR"
exec "$MAVEN_BIN" "$@"
